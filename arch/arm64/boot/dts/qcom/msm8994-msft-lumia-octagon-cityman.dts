/dts-v1/;

#include "msm8994.dtsi"
#include "msm8994-msft-lumia-octagon.dtsi"
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/soc/qcom,apr.h>
#include <dt-bindings/sound/qcom,q6asm.h>
#include <dt-bindings/sound/qcom,q6dsp-lpass-ports.h>

/ {
	model = "Microsoft Lumia 950 XL";
	compatible = "microsoft,cityman", "qcom,msm8994";
	chassis-type = "handset";

	/*
	 * q6asm MM1 → q6routing → QUAT MI2S → TAS2553.
	 * Pinmux is GPIO 58/59/62 only (SD2).
	 */
	sound {
		compatible = "qcom,apq8096-sndcard";
		model = "cityman-speaker";

		/* lpaif_quat_mode_muxsel: machine selects I2S vs PCM. */
		reg = <0x0 0xfe037000 0x0 0x4>;
		reg-names = "lpaif_quat_mode_muxsel";

		pinctrl-names = "default";
		pinctrl-0 = <&quat_mi2s_default>;

		/* 3.10 audio.dtsi RX_BIAS/MCLK; jack widget is qcom common */
		audio-routing =
			"RX_BIAS", "MCLK",
			"Headphone Jack", "HEADPHONE";

		mm1-dai-link {
			link-name = "MultiMedia1";

			cpu {
				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
			};
		};

		speaker-dai-link {
			link-name = "Speaker";

			cpu {
				sound-dai = <&q6afedai QUATERNARY_MI2S_RX>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&tas2553>;
			};
		};

		/*
		 * 3.10 LPASS_BE_SLIMBUS_0_RX → tomtom_rx1. The
		 * machine driver sets slim chmap + 9.6 MHz on
		 * non-QUAT BE links. Jack is not on QUAT MI2S.
		 */
		headset-dai-link {
			link-name = "Slimbus Playback";

			cpu {
				sound-dai = <&q6afedai SLIMBUS_0_RX>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&tomtom 0>;
			};
		};
	};
};

/*
 * Octagon ramoops@d9d00000 has //no-map commented. Proven on this
 * WP BootMgr path (Talkman ramtop): the window only survives
 * sysrq-b with no-map. Same octagon 3 GiB map on Cityman.
 */
&{/reserved-memory/ramoops@d9d00000} {
	no-map;
};

/*
 * 3.10 audio_region@0 is 0x614000. Mainline CMA rejects that
 * size ("incorrect alignment"); 8 MiB / 4 MiB align is the
 * next legal pool that still covers the ION heap. Not
 * audio_mem@c7000000.
 */
&{/reserved-memory} {
	cityman_audio_mem: audio-pool {
		compatible = "shared-dma-pool";
		size = <0x0 0x800000>;
		alignment = <0x0 0x400000>;
		reusable;
	};
};

/*
 * Catalog 0x04030000. gfx-mem ICC is BIMC GFX3D. Vote RPM VDDGFX
 * (gfx_s2b) on the GPU. Do not put OXILI_GX_GDSC on &gpu or
 * gpu_iommu — that collapses the wrong domain at bind.
 */
&gpu {
	status = "okay";
	power-domains = <&rpmpd MSM8994_VDDGFX>;
	required-opps = <&rpmpd_opp_svs_soc>;
	/* BIMC GFX3D master, not MDP port0 (that is mdss). */
	interconnects = <&bimc BIMC_MAS_GRAPHICS_3D &bimc BIMC_SLV_EBI_CH0>,
			<&ovirt OCMEM_MAS_GFX3D &ovirt OCMEM_SLV_OCMEM_GFX>;
	interconnect-names = "gfx-mem", "ocmem";
	/*
	 * 3.10 gfx3d_user carries SIDs 0 and 1. Stock dtsi only
	 * lists 0, so SID 1 would miss the user context bank.
	 */
	iommus = <&gpu_iommu 0>, <&gpu_iommu 1>;
};

/*
 * 8994 GPU SMMU has no AXI bus clock (downstream kgsl_iommu uses
 * core_clk=gfx3d + iface_clk=oxilicx_ahb). tbu must stay gfx3d.
 * Own compatible so the 8994 BFB table is not applied to 8974.
 */
&gpu_iommu {
	compatible = "qcom,msm8994-gpu-iommu";
	clocks = <&mmcc OXILICX_AHB_CLK>,
		 <&mmcc OXILI_GFX3D_CLK>;
	clock-names = "iface", "tbu";
};

/*
 * VDD_GFX via PMI8994 SPMI s2. The RPM SMD vdd_gfx node hangs
 * this board. 8996 boards wire mmcc the same way. Consumer vote,
 * not always-on.
 */
&pmi8994_spmi_regulators {
	vdd_gfx_spmi: s2 {
		regulator-name = "vdd_gfx_spmi";
		regulator-min-microvolt = <1015000>;
		regulator-max-microvolt = <1015000>;
	};
};

&mmcc {
	vdd-gfx-supply = <&vdd_gfx_spmi>;
};

/*
 * 8994 OCMEM is four regions / 2 MiB (not 8974's three / 1.5 MiB).
 * vdd-gfx keeps the controller powered; unused-disable of this rail
 * makes later TZ ocmem_lock hang. Consumer vote, not always-on.
 */
&ocmem {
	compatible = "qcom,msm8994-ocmem";
	vdd-gfx-supply = <&vdd_gfx_spmi>;
};

/*
 * 3.10 msm8994-iommu.dtsi MDP BFB (0x2000 impl-def bias removed).
 * Stock msm8994.dtsi is qcom,msm8974-mdp-iommu (8974 BFB). Keep
 * 8994 addresses 0xfd9cc000 / 0xfd9d4000. Do not paste Talkman
 * 0xfd9b4000.
 */
&mdp_iommu {
	compatible = "qcom,msm8994-mdp-iommu";
};

/*
 * CAF msm8994-mdss.dtsi (mmo + OnePlus 8994): mdp_phys 0xfd900000,
 * qcom,mdss-mdp-reg-offset = <0x1000> → HW_VERSION at 0xfd901000.
 * msm8994.dtsi maps MDP at 0xfd900100 / 0x98000, which overlaps CAF
 * DSI0 0xfd998000. Talkman #46: 0xfd900100 reads 0; 0xfd901000 is
 * 0x100a0000. Same offset on 8994 CAF. Size 0x8f000 = 0x90000-0x1000,
 * ending 0xfd990000, before DSI0. Do not paste Talkman DSI1
 * (8992 map) or Talkman MDP SMMU (8994 VBIF/SMMU stay
 * 0xfd9c8000 / 0xfd9cc000).
 */
&mdp {
	reg = <0xfd901000 0x8f000>;
};

/*
 * PMI8994 LAB @ 0xde00 / IBB @ 0xdc00 (SID 3). 3.10 msm8994-chi.dtsi
 * enables &labibb with qpnp,qpnp-labibb-mode = "oled" (AMOLED; CAF
 * string is "amoled"). LCD_AMOLED_SEL 0x44 BIT(7), LAB 4.6 V / IBB
 * 4.0 V init-amoled, IBB discharge 32 kOhm. LCD mode on this OLED
 * is a green tint and blacks that still emit (Snaccy 2026-08-27).
 * Mainline msm8994_dsi_cfg bulk_gets lab_reg / ibb_reg. Probe reads
 * PERPH_TYPE (0x24 / 0x20); do not stub.
 */
&spmi_bus {
	pmic@3 {
		labibb {
			compatible = "qcom,pmi8994-lab-ibb", "qcom,pmi8998-lab-ibb";
			qcom,amoled-mode;

			ibb: ibb {
				interrupts = <0x3 0xdc 0x2 IRQ_TYPE_EDGE_RISING>,
					     <0x3 0xdc 0x0 IRQ_TYPE_LEVEL_LOW>;
				interrupt-names = "sc-err", "ocp";
				regulator-min-microvolt = <4000000>;
				regulator-max-microvolt = <6000000>;
				qcom,discharge-resistor-kohms = <32>;
			};

			lab: lab {
				interrupts = <0x3 0xde 0x1 IRQ_TYPE_EDGE_RISING>,
					     <0x3 0xde 0x0 IRQ_TYPE_LEVEL_LOW>;
				interrupt-names = "sc-err", "ocp";
				regulator-min-microvolt = <4600000>;
				regulator-max-microvolt = <6000000>;
				qcom,soft-start-us = <800>;
			};
		};
	};
};

&mdss {
	status = "okay";
};

/*
 * CAF 8994 DSI0 0xfd998000 / DSI1 0xfd9a0000. Keep qcom,dsi-phy-20nm
 * (dsi_phy_20nm_cfgs io_start 0xfd998500 / 0xfd9a0500 + pll_init).
 * Do not stamp the 8992 20nm PHY compatible (that table's
 * io_start is the 8992 PHY map, not these 8994 addresses).
 *
 * Supplies: CAF msm8994-mdss + Snaccy cityman RPM L14/L12/L28/L2.
 * 3.10 mmo-common mdss.dtsi points host vddio at pm8994_s4; do not
 * copy Talkman SPMI s4 without a Cityman RPM timeout fact.
 * msm8994_dsi_cfg still bulk_gets vdda/vddio/vcca/vdd/lab_reg/ibb_reg.
 *
 * Dual-DSI: 3.10 sergej DSI0 cmd-sync-wait-broadcast; DSI1 broadcast +
 * cmd-sync-wait-trigger. Mainline: dual-dsi-mode + sync-dual-dsi on
 * both, master-dsi on DSI0.
 *
 * CAF clock_mmss parents byte1/pclk1 from PLL0. 20nm pll_init skips
 * the byte tree on phy->id != DSI_0. Override BYTE1/PCLK1 parents here,
 * not in msm8994.dtsi.
 *
 * Reset gpio78 (octagon DISPLAY_RESET_N, 3.10 platform-reset-gpio).
 * Panel timings from 3.10 dsi-panel-sergej-wqhd-dualdsi-cmd.dtsi.
 */
&dsi0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	vdda-supply = <&vreg_l2a_1p25>;
	vddio-supply = <&vreg_l12a_1p8>;
	vcca-supply = <&vreg_l28a_1p0>;
	vdd-supply = <&vreg_l14a_1p8>;
	lab_reg-supply = <&lab>;
	ibb_reg-supply = <&ibb>;

	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&mdss_dsi_default &mdss_te_default>;
	pinctrl-1 = <&mdss_dsi_sleep &mdss_te_sleep>;

	qcom,dual-dsi-mode;
	qcom,sync-dual-dsi;
	qcom,master-dsi;

	panel@0 {
		compatible = "microsoft,sergej-wqhd-cmd";
		reg = <0>;

		reset-gpios = <&tlmm 78 GPIO_ACTIVE_LOW>;

		/* 3.10 dsi-panel-sergej-wqhd-dualdsi-cmd.dtsi */
		qcom,mdss-dsi-panel-timings = [97 5A 3E 00 9A 9A 48 5E 4B 03 04 00];

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				sergej_in0: endpoint {
					remote-endpoint = <&dsi0_out>;
				};
			};

			port@1 {
				reg = <1>;
				sergej_in1: endpoint {
					remote-endpoint = <&dsi1_out>;
				};
			};
		};
	};
};

&dsi0_out {
	data-lanes = <0 1 2 3>;
	remote-endpoint = <&sergej_in0>;
};

&dsi0_phy {
	status = "okay";

	vddio-supply = <&vreg_l12a_1p8>;
	vcca-supply = <&vreg_l28a_1p0>;
	/* 3.10 mmo-common &mdss_dsi0 qcom,regulator-ldo-mode */
	qcom,dsi-phy-regulator-ldo-mode;
};

&dsi1 {
	status = "okay";

	vdda-supply = <&vreg_l2a_1p25>;
	vddio-supply = <&vreg_l12a_1p8>;
	vcca-supply = <&vreg_l28a_1p0>;
	vdd-supply = <&vreg_l14a_1p8>;
	lab_reg-supply = <&lab>;
	ibb_reg-supply = <&ibb>;

	qcom,dual-dsi-mode;
	qcom,sync-dual-dsi;

	/*
	 * CAF 8994 clock_mmss and 3.10 mdss_dsi@fd9a0000 parent
	 * byte1_src/pclk1_src to mdss_dsi0_pll muxes. msm8994.dtsi
	 * parents BYTE1_CLK_SRC/PCLK1_CLK_SRC to dsi1_phy 0/1. PLL1
	 * skips the byte tree. Parent both to dsi0_phy (CAF PLL0).
	 */
	assigned-clock-parents = <&dsi0_phy 0>, <&dsi0_phy 1>;
};

&dsi1_out {
	data-lanes = <0 1 2 3>;
	remote-endpoint = <&sergej_in1>;
};

&dsi1_phy {
	status = "okay";

	/*
	 * CAF msm8994-mdss.dtsi maps DSI1 phy_regulator at the DSI0
	 * window 0xfd998780 (shared), not mainline 0xfd9a0780.
	 */
	reg = <0xfd9a0300 0x200>,
	      <0xfd9a0500 0x280>,
	      <0xfd998780 0x30>;
	reg-names = "dsi_pll", "dsi_phy", "dsi_phy_regulator";

	vddio-supply = <&vreg_l12a_1p8>;
	vcca-supply = <&vreg_l28a_1p0>;
	qcom,dsi-phy-regulator-ldo-mode;
};

/*
 * LPASS Q6 / ADSP. Same node as Android4Lumia950/linux 0299fe45
 * msm8994.dtsi remoteproc@fe200000 (Talkman ADSP loaded there).
 * Not in msm8994.dtsi here: boards such as libra delete &adsp_mem
 * and dtc still resolves phandles on disabled nodes.
 *
 * 0299fe45 Talkman remaps adsp_mem to 0xce00000 — do not copy that.
 * Cityman keeps octagon adsp_mem@ca00000 (24 MiB). qcadsp8994.mbn
 * is relocatable; loadable span is exactly 0x1800000.
 *
 * firmware-name was Talkman-only on that tree. Cityman blob is
 * firmware/cityman-adsp/qcadsp8994.mbn. Do not use 8992 on the XL.
 * Do not enable &mss_pil.
 */
&soc {
	adsp_pil: remoteproc@fe200000 {
		compatible = "qcom,msm8994-adsp-pil";
		reg = <0xfe200000 0x80000>;

		interrupts-extended = <&intc GIC_SPI 162 IRQ_TYPE_EDGE_RISING>,
				      <&adsp_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
				      <&adsp_smp2p_in 1 IRQ_TYPE_EDGE_RISING>,
				      <&adsp_smp2p_in 2 IRQ_TYPE_EDGE_RISING>,
				      <&adsp_smp2p_in 3 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "wdog", "fatal", "ready",
				  "handover", "stop-ack";

		clocks = <&xo_board>;
		clock-names = "xo";

		memory-region = <&adsp_mem>;

		qcom,smem-states = <&adsp_smp2p_out 0>;
		qcom,smem-state-names = "stop";

		firmware-name = "qcom/msft/cityman/qcadsp8994.mbn";

		smd-edge {
			interrupts = <GIC_SPI 156 IRQ_TYPE_EDGE_RISING>;

			label = "lpass";
			/*
			 * 3.10 qcom,smd-adsp irq-bitmask 0x100 = bit 8.
			 * 8994 APCS mailbox writes BIT(n) at offset 8
			 * (qcom-apcs-ipc-mailbox msm8994_apcs_data).
			 * RPM already uses mboxes = <&apcs 0>.
			 * 6.13 0299fe45 qcom,ipc = <&apcs 8 10> rings
			 * bit 10 — testED: every LPASS SMD OPEN timed
			 * out (-12). Do not copy that.
			 */
			mboxes = <&apcs 8>;
			qcom,smd-edge = <1>;
			/*
			 * 8996 lpass smd-edge and octagon smp2p-lpass
			 * use pid 2. Without this, qcom_smd defaults to
			 * QCOM_SMEM_HOST_ANY and looks up FIFO items in
			 * the global TOC (item 338+cid). testEA: those
			 * entries overflow the 2 MiB smem@6a00000 map
			 * (smem.c:577) and no apr_audio_svc appears.
			 */
			qcom,remote-pid = <2>;

			#address-cells = <1>;
			#size-cells = <0>;

			/*
			 * testEB: apr_audio_svc is on the SMD edge.
			 * 8996 msm8996.dtsi APR + msm8916.dtsi
			 * q6asm-dais (no iommus: 8994 has no LPASS
			 * SMMU; driver sid = -1). No 8994
			 * HLOS1_VOTE_LPASS_* GDSC — do not copy that.
			 * sd-line 2 only (3.10 Cityman common: SD2;
			 * 60/61 touch, 63 XPU reset).
			 */
			apr {
				compatible = "qcom,apr-v2";
				qcom,smd-channels = "apr_audio_svc";
				qcom,domain = <APR_DOMAIN_ADSP>;
				#address-cells = <1>;
				#size-cells = <0>;

				service@3 {
					compatible = "qcom,q6core";
					reg = <APR_SVC_ADSP_CORE>;
				};

				q6afe: service@4 {
					compatible = "qcom,q6afe";
					reg = <APR_SVC_AFE>;

					clock-controller {
						compatible = "qcom,q6afe-clocks";
						#clock-cells = <2>;
					};

					q6afedai: dais {
						compatible = "qcom,q6afe-dais";
						#address-cells = <1>;
						#size-cells = <0>;
						#sound-dai-cells = <1>;

						dai@22 {
							reg = <QUATERNARY_MI2S_RX>;
							qcom,sd-lines = <2>;
						};

						/* 3.10 jack backend: SLIMBUS_0_RX → WCD9330 */
						dai@2 {
							reg = <SLIMBUS_0_RX>;
						};
					};
				};

				q6asm: service@7 {
					compatible = "qcom,q6asm";
					reg = <APR_SVC_ASM>;

					q6asmdai: dais {
						compatible = "qcom,q6asm-dais";
						#address-cells = <1>;
						#size-cells = <0>;
						#sound-dai-cells = <1>;
						memory-region = <&cityman_audio_mem>;
						/* 3.10 audio_heap qcom,proc-id */
						qcom,proc-id = <1>;

						dai@0 {
							reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>;
							direction = <Q6ASM_DAI_RX>;
						};
					};
				};

				q6adm: service@8 {
					compatible = "qcom,q6adm";
					reg = <APR_SVC_ADM>;

					q6routing: routing {
						compatible = "qcom,q6adm-routing";
						#sound-dai-cells = <0>;
					};
				};
			};
		};
	};
};

/*
 * 3.10 msm8994.dtsi slim@fe12f000: core 0xfe12f000/0x2c000 IRQ 163,
 * BAM 0xfe104000/0x20000 IRQ 164. Mainline NGD compatible is
 * qcom,slim-ngd-v1.5.0 (same SPI and core size as MSM8996).
 * ADSP owns the BAM (controlled-remotely, 31 channels, 2 EEs).
 * MSGQ pipes 3/4 match in-tree slim-ngd. WCD9330 EA is
 * slim217,130 — not WCD9335 (slim217,1a0).
 */
&soc {
	slimbam: dma-controller@fe104000 {
		compatible = "qcom,bam-v1.7.0";
		reg = <0xfe104000 0x20000>;
		interrupts = <GIC_SPI 164 IRQ_TYPE_LEVEL_HIGH>;
		#dma-cells = <1>;
		qcom,ee = <1>;
		qcom,num-ees = <2>;
		num-channels = <31>;
		qcom,controlled-remotely;
	};

	slim_msm: slim-ngd@fe12f000 {
		compatible = "qcom,slim-ngd-v1.5.0";
		reg = <0xfe12f000 0x2c000>;
		interrupts = <GIC_SPI 163 IRQ_TYPE_LEVEL_HIGH>;
		dmas = <&slimbam 3>, <&slimbam 4>;
		dma-names = "rx", "tx";
		#address-cells = <1>;
		#size-cells = <0>;
		/*
		 * Mapping NGD at probe reboots this SoC. The
		 * driver attaches after ADSP is up (sysfs ngd_hw,
		 * then ngd_up). See qcom-lumia-octagon.rst.
		 */
		status = "okay";

		slim@1 {
			reg = <1>;
			#address-cells = <2>;
			#size-cells = <0>;

			/* 3.10 IFD [00 00 30 01 17 02], PGD [00 01 30 01 17 02] */
			tomtom_ifd: codec@0,0 {
				compatible = "slim217,130";
				reg = <0 0>;
			};

			tomtom: codec@1,0 {
				compatible = "slim217,130";
				reg = <1 0>;
				#sound-dai-cells = <1>;
				reset-gpios = <&tlmm 68 GPIO_ACTIVE_LOW>;
				slim-ifc-dev = <&tomtom_ifd>;
				/*
				 * 3.10 osr_clk is clock_rpm clk_div_clk1
				 * plus PMGPIO 15. Octagon already has
				 * that as divclk1 (gpio-gate + audio_mclk).
				 */
				clocks = <&divclk1>;
				clock-names = "mclk";
				/* 3.10 msm8994.dtsi cdc-static-supplies */
				vdd-buck-supply = <&vreg_s5a_2p15>;
				vdd-tx-h-supply = <&vreg_s4a_1p8>;
				vdd-rx-h-supply = <&vreg_s4a_1p8>;
				vdd-px-supply = <&vreg_s4a_1p8>;
				vdd-a-1p2v-supply = <&vreg_l11a_1p2>;
				vdd-cx1-supply = <&vreg_l11a_1p2>;
				vdd-cx2-supply = <&vreg_l11a_1p2>;
				/* 3.10 wcd9xxx-irq cdc-int: TLMM 72, HIGH */
				interrupts-extended = <&tlmm 72 IRQ_TYPE_LEVEL_HIGH>;
				pinctrl-names = "default";
				pinctrl-0 = <&wcd_intr_default>;
				qcom,mbhc-insert-detect-inverted;
			};
		};
	};
};

&tas2553 {
	#sound-dai-cells = <0>;
};

&tlmm {
	quat_mi2s_default: quat-mi2s-default-state {
		pins = "gpio58", "gpio59", "gpio62";
		function = "qua_mi2s";
		drive-strength = <8>;
		bias-disable;
	};

	/* 3.10 msm8994-pinctrl.dtsi wcd_intr_default */
	wcd_intr_default: wcd-intr-default-state {
		pins = "gpio72";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
		input-enable;
	};
};

/*
 * Volume Down is PM8994 PON resin. Stock pm8994.dtsi leaves
 * that node disabled; octagon sets KEY_VOLUMEDOWN but not
 * status. Volume Up is PMGPIO 3 (VOL_UP_N, high at rest).
 * Camera Focus was also KEY_VOLUMEUP on PMGPIO 5 (low at
 * rest), so vol-up looked stuck held. Cityman only — do
 * not copy onto Talkman.
 */
&pm8994_resin {
	status = "okay";
};

&{/gpio-keys/camfocus-key} {
	linux,code = <KEY_CAMERA_FOCUS>;
};
